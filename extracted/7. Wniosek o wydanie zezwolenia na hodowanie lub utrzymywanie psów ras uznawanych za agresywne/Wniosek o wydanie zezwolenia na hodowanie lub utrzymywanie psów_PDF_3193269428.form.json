ionConfig": {"consents": [{"description": "Oświadczam, że psy nie będą wykorzystywane do polowań.", "required": true}, {"description": "Oświadczam, że zaszczepiono psa/psy przeciwko wściekliźnie – w załączeniu kopia dla każdego psa.", "required": true}, {"description": "Oświadczam, że zapewniam warunki utrzymywania psa, zgodnie z rozporządzeniem Ministra Rolnictwa i Rozwoju Wsi z dnia 5 lipca 2010r.", "required": true}], "required": true, "files": []}}}, {"x": 0, "y": 2, "rows": 1, "cols": 3, "field": {"id": "5098efd4-237f-547f-9428-f5351d3f042d", "type": "TEXT_BLOCK", "techName": "text_block", "title": "", "description": "Opłata skarbowa – 82 zł. Numer konta: 12 1223 1232 1233 2312 2342 2342", "options": [], "validation": [], "readOnly": false, "states": [], "questionOrder": 2, "tooltipMessage": "", "repeatingSectionGrid": []}}]}}]}, {"id": "716dc950-22bb-5eef-a90a-e8d924d84d3a", "title": "Przetwarzanie danych osobowych", "type": "MAIN", "questions": [{"x": 0, "y": 0, "rows": 6, "cols": 3, "field": {"id": "eec84d0b-f7ab-5b30-aed1-fc368124fb78", "type": "SECTION", "techName": "administrator_i_cele_przetwarzania", "title": "Administrator i cele przetwarzania", "description": "", "options": [], "validation": [], "readOnly": false, "states": [], "questionOrder": 0, "tooltipMessage": "", "repeatingSectionGrid": [{"x": 0, "y": 0, "rows": 1, "cols": 3, "field": {"id": "0445f44a-724e-5b0a-99d5-572e17ba6078", "type": "TEXT_BLOCK", "techName": "informacja_ogolna", "title": "Informacja ogólna", "description": "Niniejszą informację otrzymuje Pani/Pan w związku z obowiązkami określonymi w art. 13 rozporządzenia Parlamentu Europejskiego i Rady (UE) 2016/679 z dnia 27 kwietnia 2016 r. w sprawie ochrony osób fizycznych w związku z przetwarzaniem danych osobowych i w sprawie swobodnego przepływu takich danych oraz uchylenia dyrektywy 95/46/WE (ogólne rozporządzenie o ochronie danych) (Dziennik Urzędowy Unii Europejskiej z dnia 4 maja 2016 r. L 119/1).", "options": [], "validation": [], "readOnly": false, "states": [], "questionOrder": 0, "tooltipMessage": "", "repeatingSectionGrid": []}}, {"x": 0, "y": 1, "rows": 1, "cols": 3, "field": {"id": "4a61313b-50cd-5a2d-8d12-0195a7ddb33e", "type": "TEXT_BLOCK", "techName": "administrator_danych", "title": "Administrator danych", "description": "Administratorem Pani/Pana danych osobowych jest Prezydent Wrocławia. Możesz się z nami skontaktować w następujący sposób:\n• listownie na adres: Prezydent Wrocławia, Urząd Miejski Wrocławia, pl. Nowy Targ 1-8, 50-141 Wrocław,\n• za pośrednictwem poczty elektronicznej na adres: wsr@um.wroc.pl\n• telefonicznie: +48 71 799 67 00.", "options": [], "validation": [], "readOnly": false, "states": [], "questionOrder": 1, "tooltipMessage": "", "repeatingSectionGrid": []}}, {"x": 0, "y": 2, "rows": 1, "cols": 3, "field": {"id": "e7f1fe9e-4741-5399-8982-9301b0e88ed9", "type": "TEXT_BLOCK", "techName": "cele_przetwarzania_danych", "title": "Cele przetwarzania danych", "description": "Pani/Pana dane osobowe będą przetwarzane w celu\n• wydania zezwolenia na hodowanie/utrzymywanie* charta/chartów* lub mieszańca charta/mieszańców chartów,\n• zaksięgowania i rozliczenia zapłaconej opłaty skarbowej.", "options": [], "validation": [], "readOnly": false, "states": [], "questionOrder": 2, "tooltipMessage": "", "repeatingSectionGrid": []}}, {"x": 0, "y": 3, "rows": 1, "cols": 3, "field": {"id": "54ef71b6-0801-5235-9063-c74a33216cd6", "type": "TEXT_BLOCK", "techName": "podstawy_prawne_przetwarzania", "title": "Podstawy prawne przetwarzania", "description": "Będziemy przetwarzać Pani/Pana dane osobowe na podstawie art. 6 ust. 1 lit. c) RODO oraz ustawy kodeks postępowania administracyjnego i ustawy Prawo łowieckie.", "options": [], "validation": [], "readOnly": false, "states": [], "questionOrder": 3, "tooltipMessage": "", "repeatingSectionGrid": []}}, {"x": 0, "y": 4, "rows": 1, "cols": 3, "field": {"id": "93e71ce3-8a23-5877-a60a-ffcb5fc5386f", "type": "TEXT_BLOCK", "techName": "obligatoryjnosc_fakultatywnosc_podania_danych_osobowych", "title": "Obligatoryjność/fakultatywność podania danych osobowych", "description": "Podanie przez Panią/Pana danych osobowych jest wymogiem wynikającym z ustawy Prawo łowieckie oraz kodeksu postepowania administracyjnego.", "options": [], "validation": [], "readOnly": false, "states": [], "questionOrder": 4, "tooltipMessage": "", "repeatingSectionGrid": []}}]}}, {"x": 0, "y": 6, "rows": 6, "cols": 3, "field": {"id": "ca7a790a-f4b7-5245-8b02-613dbcbbc187", "type": "SECTION", "techName": "okres_retencji_odbiorcy_i_prawa", "title": "Okres retencji, odbiorcy i prawa", "description": "", "options": [], "validation": [], "readOnly": false, "states": [], "questionOrder": 1, "tooltipMessage": "", "repeatingSectionGrid": [{"x": 0, "y": 0, "rows": 1, "cols": 3, "field": {"id": "35294ea1-d40b-5823-a8b1-fb3331082139", "type": "TEXT_BLOCK", "techName": "okres_retencji", "title": "Okres retencji", "description": "Pani/Pana dane osobowe będą przechowywane przez okres 5 lat, następnie Archiwum Państwowe po ekspertyzie dokumentów może podjąć decyzję o ich zniszczeniu lub przekwalifikować na kategorię A i wtedy Pani/Pana dane osobowe będą przetwarzane przez Administratora przez 25 lat od stycznia kolejnego roku po zakończeniu Pani/Pana sprawy a następnie zostaną przekazane do Archiwum Państwowego we Wrocławiu, gdzie będą przetwarzane wieczyście.", "options": [], "validation": [], "readOnly": false, "states": [], "questionOrder": 0, "tooltipMessage": "", "repeatingSectionGrid": []}}, {"x": 0, "y": 1, "rows": 1, "cols": 3, "field": {"id": "ac6ae8cf-62f5-5a09-8d63-fbe8c5ebeb5f", "type": "TEXT_BLOCK", "techName": "odbiorcy_danych", "title": "Odbiorcy danych", "description": "Odbiorcami Pani/Pana danych osobowych mogą być:\n• dostawcy usług IT\n• podmioty upoważnione na podstawie przepisów prawa\nTakie podmioty przetwarzają dane na podstawie umowy z nami i tylko zgodnie z naszymi poleceniami.", "options": [], "validation": [], "readOnly": false, "states": [], "questionOrder": 1, "tooltipMessage": "", "repeatingSectionGrid": []}}, {"x": 0, "y": 2, "rows": 1, "cols": 3, "field": {"id": "396d1d71-22a8-54f7-a6eb-2ea7712f6551", "type": "TEXT_BLOCK", "techName": "przyslugujace_prawa", "title": "Przysługujące prawa", "description": "Przysługują Pani/Panu:\n• prawo dostępu do swoich danych oraz otrzymania ich kopii,\n• prawo do sprostowania (poprawiania) swoich danych,\n• prawo do ograniczenia przetwarzania danych,\n• prawo wniesienia skargi do organu nadzorczego - tj. Prezesa Urzędu Ochrony Danych Osobowych", "options": [], "validation": [], "readOnly": false, "states": [], "questionOrder": 2, "tooltipMessage": "", "repeatingSectionGrid": []}}, {"x": 0, "y": 3, "rows": 1, "cols": 3, "field": {"id": "3a6c3f69-d5a4-5dd2-825c-47c27f05f5fd", "type": "TEXT_BLOCK", "techName": "inspektor_ochrony_danych", "title": "Inspektor Ochrony Danych", "description": "W Urzędzie wyznaczony został Inspektor Ochrony Danych – Sebastian Sobecki. Jest to osoba, z którą można się kontaktować w sprawach dotyczących przetwarzania Twoich danych osobowych oraz korzystania z przysługujących Ci praw związanych z przetwarzaniem danych.\nZ Inspektorem można kontaktować się w następujący sposób:\n• listownie na adres: al. M. Kromera 44, 51-163 Wrocław\n• przez e-mail: iod@um.wroc.pl\n• telefonicznie: 71 777 77 24.", "options": [], "validation": [], "readOnly": false, "states": [], "questionOrder": 3, "tooltipMessage": "", "repeatingSectionGrid": []}}, {"x": 0, "y": 4, "rows": 1, "cols": 3, "field": {"id": "b85882a6-509d-5166-8a13-631af2c41ca8", "type": "TEXT_BLOCK", "techName": "zautomatyzowane_podejmowanie_decyzji", "title": "Zautomatyzowane podejmowanie decyzji", "description": "Pani/Pana dane nie będą podlegały profilowaniu lub zautomatyzowanemu podejmowaniu decyzji", "options": [], "validation": [], "readOnly": false, "states": [], "questionOrder": 4, "tooltipMessage": "", "repeatingSectionGrid": []}}]}}]}, {"id": "df0e417f-8920-5